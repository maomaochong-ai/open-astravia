{
	"name": "vetta-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.4",
	"workspaces": [
		"packages/capability-sdk",
		"packages/capability-runtime",
		"packages/ai",
		"packages/agent",
		"packages/ecosystem-adapter",
		"packages/coding-agent",
		"packages/plugins/plugin-sdk",
		"packages/plugins/plugin-vite",
		"packages/plugins/plugin-cli",
		"packages/plugins/presets/*",
		"packages/plugins/externals/*",
		"packages/theme-sdk",
		"packages/theme-ui",
		"packages/themes/builtin/*",
		"packages/ui",
		"packages/markdown",
		"packages/runtime-core",
		"packages/action-rpc",
		"packages/runtime-subagents",
		"packages/runtime-knowledge",
		"packages/runtime-tools",
		"packages/runtime-mcp",
		"packages/runtime-storage",
		"packages/runtime-node",
		"packages/runtime-telemetry",
		"packages/runtime-desktop",
		"packages/toolkit",
		"packages/skill-presets",
		"apps/cli-app",
		"apps/desktop-app",
		"apps/admin",
		"apps/docs-site",
		"apps/site",
		"packages/coding-agent/examples/extensions/with-deps",
		"packages/coding-agent/examples/extensions/custom-provider-anthropic",
		"packages/coding-agent/examples/extensions/custom-provider-gitlab-duo",
		"packages/coding-agent/examples/extensions/custom-provider-qwen-cli"
	],
	"scripts": {
		"clean": "bun run --workspaces clean",
		"build": "./scripts/build.sh libs",
		"build:all": "./scripts/build.sh all",
		"build:desktop": "./scripts/build.sh desktop",
		"build:cli": "./scripts/build.sh cli",
		"build:admin": "./scripts/build.sh admin",
		"build:docs": "bun run --cwd apps/docs-site build",
		"build:preset": "./scripts/build.sh preset",
		"dev": "concurrently --names \"ai,agent,coding-agent\" --prefix-colors \"cyan,yellow,red\" \"cd packages/ai && bun run dev\" \"cd packages/agent && bun run dev\" \"cd packages/coding-agent && bun run dev\"",
		"dev:tsc": "concurrently --names \"ai\" --prefix-colors \"cyan\" \"cd packages/ai && bun run dev:tsc\"",
		"verify:ui:start": "bun run --cwd apps/desktop-app verify:ui:start",
		"verify:ui:start:fresh": "bun run --cwd apps/desktop-app verify:ui:start:fresh",
		"verify:ui:start:debug": "bun run --cwd apps/desktop-app verify:ui:start:debug",
		"verify:ui:sync:debug": "bun run --cwd apps/desktop-app verify:ui:sync:debug",
		"verify:ui:status": "bun run --cwd apps/desktop-app verify:ui:status",
		"verify:ui:status:debug": "bun run --cwd apps/desktop-app verify:ui:status:debug",
		"verify:ui:status:dev": "bun run --cwd apps/desktop-app verify:ui:status:dev",
		"verify:ui:stop": "bun run --cwd apps/desktop-app verify:ui:stop",
		"verify:ui:stop:debug": "bun run --cwd apps/desktop-app verify:ui:stop:debug",
		"verify:ui:attach": "bun run --cwd apps/desktop-app verify:ui:attach",
		"verify:ui:attach:debug": "bun run --cwd apps/desktop-app verify:ui:attach:debug",
		"verify:ui:attach:dev": "bun run --cwd apps/desktop-app verify:ui:attach:dev",
		"verify:ui:pw": "bun run --cwd apps/desktop-app verify:ui:pw",
		"verify:ui:pw:debug": "bun run --cwd apps/desktop-app verify:ui:pw:debug",
		"verify:ui:pw:dev": "bun run --cwd apps/desktop-app verify:ui:pw:dev",
		"verify:ui:detach": "bun run --cwd apps/desktop-app verify:ui:detach",
		"verify:ui:debug": "bun run --cwd apps/desktop-app verify:ui:debug",
		"verify:ui:debug:debug": "bun run --cwd apps/desktop-app verify:ui:debug:debug",
		"verify:ui:debug:dev": "bun run --cwd apps/desktop-app verify:ui:debug:dev",
		"verify:ui:runtime-canary": "bun run --cwd apps/desktop-app verify:ui:runtime-canary",
		"verify:artifact:installed": "bun run --cwd apps/cli-app verify:artifact:installed",
		"verify:runtime-contract": "bun run --cwd apps/cli-app verify:runtime-contract",
		"verify:agent-hosts": "bun scripts/verify-coding-agent-hosts.mjs",
		"check:lint": "bun run scripts/quality/check-lint.mjs",
		"check:lint:fix": "bun run scripts/quality/check-lint.mjs --write",
		"check:types": "concurrently --names \"root,cli,desktop,admin,docs\" --prefix-colors \"blue,yellow,green,cyan,magenta\" \"tsgo --noEmit\" \"bun run --cwd apps/cli-app typecheck\" \"bunx tsc --noEmit -p apps/desktop-app/tsconfig.json --incremental --tsBuildInfoFile node_modules/.desktop-app-check.tsbuildinfo\" \"bun run --cwd apps/admin check\" \"bun run --cwd apps/docs-site check\"",
		"check:types:build-surfaces": "bunx tsgo --noEmit -p apps/cli-app/tsconfig.build.json",
		"check:guards": "bun run scripts/quality/check-guards.mjs",
		"check:staged": "bunx @biomejs/biome check --write --error-on-warnings --staged --no-errors-on-unmatched",
		"check:precommit": "bun run scripts/quality/precommit.mjs",
		"check:quick": "bun run scripts/quality/check-quick.mjs",
		"check": "concurrently --names \"lint,types,guards\" --prefix-colors \"cyan,yellow,magenta\" \"bun run check:lint\" \"bun run check:types\" \"bun run check:guards\"",
		"fix": "bun run check:lint:fix",
		"test": "bun run --workspaces --if-present test",
		"vitest": "bun scripts/quality/run-vitest.mjs",
		"test:quality": "bun scripts/quality/run-vitest.mjs --run .claude/hooks/check-file-lines.test.mjs scripts/quality/quality-gates.test.mjs scripts/quality/coding-agent-architecture.test.mjs scripts/quality/coding-agent-tool-public-surface.test.mjs scripts/quality/runtime-coding-agent-independence.test.mjs scripts/quality/runtime-subagents-boundary.test.mjs scripts/quality/runtime-failure-contract.test.mjs scripts/quality/runtime-platform-boundary.test.mjs scripts/quality/runtime-storage-protocol-boundary.test.mjs scripts/quality/runtime-tools-protocol-boundary.test.mjs scripts/quality/runtime-mcp-protocol-boundary.test.mjs scripts/quality/agent-ai-maintainability.test.mjs",
		"test:unit": "bun run scripts/quality/test-pkg.mjs ai agent runtime-mcp coding-agent ecosystem-adapter",
		"test:pkg": "bun run scripts/quality/test-pkg.mjs",
		"test:changed": "bun run scripts/quality/test-changed.mjs",
		"deadcode": "knip --config knip.config.ts",
		"deadcode:report": "knip --config knip.config.ts --no-exit-code",
		"version:patch": "npm version patch -ws --no-git-tag-version && node scripts/sync-versions.js && rm -rf node_modules packages/*/node_modules apps/*/node_modules package-lock.json && bun install",
		"version:minor": "npm version minor -ws --no-git-tag-version && node scripts/sync-versions.js && rm -rf node_modules packages/*/node_modules apps/*/node_modules package-lock.json && bun install",
		"version:major": "npm version major -ws --no-git-tag-version && node scripts/sync-versions.js && rm -rf node_modules packages/*/node_modules apps/*/node_modules package-lock.json && bun install",
		"version:set": "npm version -ws",
		"prepublishOnly": "bun run clean && bun run build && bun run check",
		"publish": "bun run prepublishOnly && npm publish -ws",
		"publish:dry": "bun run prepublishOnly && npm publish -ws --dry-run",
		"publish:private": "bun run prepublishOnly && npm publish -ws",
		"release:patch": "node scripts/release.mjs patch",
		"release:minor": "node scripts/release.mjs minor",
		"release:major": "node scripts/release.mjs major",
		"release:desktop:patch": "node scripts/release-desktop.mjs patch",
		"release:desktop:minor": "node scripts/release-desktop.mjs minor",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@playwright/cli": "^0.1.17",
		"@types/node": "^22.10.5",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"@vitest/coverage-v8": "3.2.6",
		"concurrently": "^9.2.1",
		"husky": "^9.1.7",
		"knip": "5.88.1",
		"tsx": "^4.20.3",
		"typescript": "^5.9.2",
		"vitest": "^3.2.4"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"version": "0.55.3",
	"dependencies": {
		"@mariozechner/jiti": "^2.6.5",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-slot": "^1.2.4",
		"@vetta/cli-app": "workspace:*",
		"@vetta/coding-agent": "workspace:*",
		"date-fns": "^4.1.0",
		"get-east-asian-width": "^1.4.0",
		"koffi": "^2.15.1"
	},
	"overrides": {
		"@types/react": "19.2.17",
		"rimraf": "6.1.2",
		"@wdio/native-utils": "2.5.0"
	}
}
