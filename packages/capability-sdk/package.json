{
	"name": "@vetta/capability-sdk",
	"version": "0.0.1",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./access": {
			"types": "./dist/access.d.ts",
			"import": "./dist/access.js"
		},
		"./foundation": {
			"types": "./dist/foundation.d.ts",
			"import": "./dist/foundation.js"
		},
		"./domain": {
			"types": "./dist/domain.d.ts",
			"import": "./dist/domain.js"
		}
	},
	"files": ["dist"],
	"scripts": {
		"catalog:check": "bun run scripts/generate-catalog.ts --check",
		"catalog:generate": "bun run scripts/generate-catalog.ts",
		"clean": "rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "bunx vitest --run"
	},
	"dependencies": {
		"@sinclair/typebox": "^0.34.41"
	},
	"devDependencies": {
		"@types/node": "^22.10.5",
		"typescript": "^5.9.2"
	}
}
