{
	"name": "@vetta/runtime-core",
	"version": "0.0.1",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./kernel": {
			"types": "./dist/kernel/index.d.ts",
			"import": "./dist/kernel/index.js"
		},
		"./agents": {
			"types": "./dist/agents/index.d.ts",
			"import": "./dist/agents/index.js"
		},
		"./observation": {
			"types": "./dist/observation/index.d.ts",
			"import": "./dist/observation/index.js"
		},
		"./conversation": {
			"types": "./dist/conversation/index.d.ts",
			"import": "./dist/conversation/index.js"
		},
		"./sandbox": {
			"types": "./dist/sandbox/index.d.ts",
			"import": "./dist/sandbox/index.js"
		},
		"./session-extensions": {
			"types": "./dist/session-extensions/index.d.ts",
			"import": "./dist/session-extensions/index.js"
		}
	},
	"files": ["dist"],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "bun ../../scripts/quality/run-vitest.mjs --run --config vitest.config.ts"
	},
	"dependencies": {
		"@vetta/agent-core": "workspace:*",
		"@vetta/ai": "workspace:*"
	},
	"devDependencies": {
		"typescript": "^5.9.2",
		"@types/node": "^22.10.5"
	}
}
