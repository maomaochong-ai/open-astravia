{
	"name": "@vetta/coding-agent",
	"version": "0.0.1",
	"description": "Coding Agent features, policies, and stable API semantics",
	"type": "module",
	"piConfig": {
		"name": "vetta"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./hooks": {
			"types": "./dist/public-api/hooks.d.ts",
			"import": "./dist/public-api/hooks.js"
		},
		"./host-services": {
			"types": "./dist/public-api/host-services.d.ts",
			"import": "./dist/public-api/host-services.js"
		},
		"./historical-sessions": {
			"types": "./dist/public-api/historical-sessions.d.ts",
			"import": "./dist/public-api/historical-sessions.js"
		},
		"./bootstrap": {
			"types": "./dist/public-api/bootstrap.d.ts",
			"import": "./dist/public-api/bootstrap.js"
		},
		"./config": {
			"types": "./dist/config.d.ts",
			"import": "./dist/config.js"
		},
		"./extensions": {
			"types": "./dist/public-api/extensions.d.ts",
			"import": "./dist/public-api/extensions.js"
		},
		"./extensions/pi-compat": {
			"types": "./dist/extensions/pi-compat/index.d.ts",
			"import": "./dist/extensions/pi-compat/index.js"
		},
		"./export-html": {
			"types": "./dist/public-api/export-html.d.ts",
			"import": "./dist/public-api/export-html.js"
		},
		"./profile": {
			"types": "./dist/public-api/profile.d.ts",
			"import": "./dist/public-api/profile.js"
		},
		"./cli-guidance": {
			"types": "./dist/public-api/cli-guidance.d.ts",
			"import": "./dist/public-api/cli-guidance.js"
		},
		"./resources": {
			"types": "./dist/public-api/resources.d.ts",
			"import": "./dist/public-api/resources.js"
		},
		"./rpc": {
			"types": "./dist/public-api/rpc.d.ts",
			"import": "./dist/public-api/rpc.js"
		},
		"./runtime": {
			"types": "./dist/public-api/runtime.d.ts",
			"import": "./dist/public-api/runtime.js"
		},
		"./sdk": {
			"types": "./dist/public-api/sdk.d.ts",
			"import": "./dist/public-api/sdk.js"
		},
		"./session-extensions": {
			"types": "./dist/public-api/session-extensions.d.ts",
			"import": "./dist/public-api/session-extensions.js"
		},
		"./settings": {
			"types": "./dist/public-api/settings.d.ts",
			"import": "./dist/public-api/settings.js"
		},
		"./host": {
			"types": "./dist/host/tool-environment/node/index.d.ts",
			"import": "./dist/host/tool-environment/node/index.js"
		},
		"./composition": {
			"types": "./dist/composition/index.d.ts",
			"import": "./dist/composition/index.js"
		},
		"./model-context": {
			"types": "./dist/public-api/model-context.d.ts",
			"import": "./dist/public-api/model-context.js"
		}
	},
	"files": [
		"dist",
		"docs",
		"examples",
		"banner.txt",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"build": "bun run generate:personas && bun run generate:themes && tsgo -p tsconfig.build.json && bun run copy-assets",
		"generate:personas": "node scripts/generate-personas.mjs",
		"generate:themes": "node scripts/generate-themes.mjs",
		"check:generated-prompts": "node scripts/generate-personas.mjs --check && node scripts/generate-themes.mjs --check",
		"copy-assets": "shx mkdir -p dist/modes/interactive/theme && shx cp src/modes/interactive/theme/*.json dist/modes/interactive/theme/ && shx mkdir -p dist/export-html/vendor && shx cp src/export-html/assets/template.html src/export-html/assets/template.css src/export-html/assets/template.js dist/export-html/ && shx cp src/export-html/assets/vendor/*.js dist/export-html/vendor/",
		"test": "bun ../../scripts/quality/run-vitest.mjs --run",
		"test:coverage": "bun ../../scripts/quality/run-vitest.mjs --run --coverage",
		"prepublishOnly": "bun run clean && bun run build"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@silvia-odwyer/photon-node": "^0.3.4",
		"@sinclair/typebox": "^0.34.41",
		"@vetta/action-rpc": "workspace:*",
		"@vetta/agent-core": "workspace:*",
		"@vetta/ai": "workspace:*",
		"@vetta/ecosystem-adapter": "workspace:*",
		"@vetta/runtime-core": "workspace:*",
		"@vetta/runtime-mcp": "workspace:*",
		"@vetta/runtime-node": "workspace:*",
		"@vetta/runtime-knowledge": "workspace:*",
		"@vetta/runtime-storage": "workspace:*",
		"@vetta/runtime-subagents": "workspace:*",
		"@vetta/runtime-telemetry": "workspace:*",
		"@vetta/runtime-tools": "workspace:*",
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1",
		"chalk": "^5.5.0",
		"cli-highlight": "^2.1.11",
		"diff": "^8.0.2",
		"file-type": "^21.1.1",
		"glob": "^13.0.1",
		"hosted-git-info": "^9.0.2",
		"ignore": "^7.0.5",
		"marked": "^15.0.12",
		"minimatch": "^10.1.1",
		"strip-ansi": "^7.1.0",
		"typebox": "1.3.7",
		"yaml": "^2.8.2",
		"zod": "^4.4.3"
	},
	"overrides": {
		"rimraf": "6.1.2",
		"gaxios": {
			"rimraf": "6.1.2"
		}
	},
	"devDependencies": {
		"@types/diff": "^7.0.2",
		"@types/hosted-git-info": "^3.0.5",
		"@types/ms": "^2.1.0",
		"@types/node": "^24.3.0",
		"@types/proper-lockfile": "^4.1.4",
		"proper-lockfile": "^4.1.2",
		"shx": "^0.4.0",
		"typescript": "^5.7.3"
	},
	"keywords": [
		"coding-agent",
		"ai",
		"llm",
		"cli",
		"tui",
		"agent"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	}
}
