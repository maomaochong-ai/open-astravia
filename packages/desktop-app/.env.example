# Production API endpoint used by packaged builds.
VETTA_SERVER_URL=https://api.openvetta.com/api/v1

# ─── Desktop 自动更新源 ───────────────────────────────────────────────────────
# none | generic | github。更新源是构建配置，不与 Windows/macOS/Linux 绑定。
VETTA_UPDATE_PROVIDER=generic
# generic 适用于 R2、自建对象存储或任意静态 HTTP/CDN 根路径。
VETTA_UPDATE_URL=https://releases.openvetta.com/desktop/stable
# GitHub Releases 适用于开源分发；切换 provider 后无需修改客户端代码。
# VETTA_UPDATE_GITHUB_OWNER=owner
# VETTA_UPDATE_GITHUB_REPO=repository
#
# R2 上传凭据仅供 publish:updates:r2 使用。CI 通过 Secret 注入；
# 本地正式测试可填在已忽略的 .env.development，不得提交真实凭据。
# VETTA_R2_ACCOUNT_ID=cloudflare-account-id
# VETTA_R2_ACCESS_KEY_ID=r2-access-key-id
# VETTA_R2_SECRET_ACCESS_KEY=r2-secret-access-key
# VETTA_R2_BUCKET=vetta-releases
# VETTA_R2_PREFIX=desktop/stable
# 仅用于手动验证 QA 版本；正式发版不要设置。
# VETTA_R2_ALLOW_QA_STABLE=true

# 外观设置「界面主题」区段（default / xianxia）。默认不展示；设为 true 开启。
# 也可命令行内联：VETTA_SHOW_UI_THEME=true bun run dev
# VETTA_SHOW_UI_THEME=true

# 系统插件租户：决定 build:presets 与打包阶段包含哪些 preset 插件。
# 取值见 packages/plugins/tenants.json（如 common / tenantb），缺省取该文件的 default。
# 也可命令行内联覆盖（优先级最高）：VETTA_TENANT=tenantb bun run dev
# VETTA_TENANT=common

# ─── macOS 代码签名 / 公证 ───────────────────────────────────────────────────
# 证书与公证凭据是机密，只通过 shell 环境或 CI Secret 注入，不要写进任何 .env 文件。
# 相关变量（CSC_LINK / CSC_KEY_PASSWORD / APPLE_TEAM_ID / APPLE_API_* / APPLE_ID …）
# 齐全时 dist:mac 自动开启签名+公证，一个都不设则产出未签名包。
# 申请与注入流程见 docs/deploy/apple-code-signing.md。

# ─── GitHub 开源能力市场 ──────────────────────────────────────────────────────
# 未配置仓库时不创建内置 GitHub 市场来源。ARCHIVE_URL 省略时由仓库与 REF 推导。
# VETTA_OPEN_MARKETPLACE_REPOSITORY=https://github.com/owner/repository
# VETTA_OPEN_MARKETPLACE_REF=main
# VETTA_OPEN_MARKETPLACE_ARCHIVE_URL=https://github.com/owner/repository/archive/refs/heads/main.zip

# ─── Desktop telemetry: Sentry（错误、崩溃、性能）─────────────────────────────
# 未配置 DSN 时 Sentry 为 Noop。DSN 会进入桌面构建产物，不要在这里填写 Sentry Auth Token。
# VETTA_SENTRY_DSN=https://public-key@your-sentry.example.com/project-id

# 每次正式构建使用不可变 release，并确保运行时与 Source Map 上传完全一致。
# 推荐格式：vetta-desktop@<version>+<build-id>
# VETTA_SENTRY_RELEASE=vetta-desktop@0.0.0+local

# 推荐取值：development / staging / production。
# VETTA_TELEMETRY_ENVIRONMENT=development

# Sentry performance tracing 采样率，范围 0～1；缺省为 0，不自动开启性能采样。
# VETTA_SENTRY_TRACES_SAMPLE_RATE=0

# ─── Desktop telemetry: PostHog（产品分析、Feature Flag、Replay）─────────────
# 使用 PostHog Project API Key（通常以 phc_ 开头），不要使用 Personal API Key。
# 未配置时 PostHog 为 Noop。Project API Key 会进入 Renderer 构建产物。
# VETTA_POSTHOG_KEY=phc_xxx

# PostHog Cloud US；EU、自托管部署请替换为对应 ingest host。
# VETTA_POSTHOG_HOST=https://us.i.posthog.com

# Replay 默认关闭；只有设置为 true 才允许录制。
# VETTA_POSTHOG_REPLAY_ENABLED=false

# Replay 采样率，范围 0～1；未设置时由 PostHog 项目端配置决定。
# VETTA_POSTHOG_REPLAY_SAMPLE_RATE=0.05

# ─── Sentry Source Map 上传（仅 CI / release 构建）──────────────────────────
# 以下四项同时存在时，Main、Preload、Renderer 才生成并上传 hidden Source Map。
# VETTA_SENTRY_RELEASE 与上面的运行时 release 必须完全相同。
# VETTA_SENTRY_ORG=your-org-slug
# VETTA_SENTRY_PROJECT=your-project-slug

# 机密：只通过 CI Secret 或本地临时环境变量注入。不要写入或提交任何 .env 文件。
# VETTA_SENTRY_AUTH_TOKEN=sntrys_xxx

# 仅自托管 Sentry 需要；Sentry SaaS 不设置。
# VETTA_SENTRY_URL=https://sentry.example.com

# 不上传 Sentry、仅本地调试 Main 堆栈时可单独生成 Main Source Map。
# VETTA_MAIN_SOURCEMAP=true

# Langfuse tracing is opt-in.
# Uncomment this block only when you want to send full agent/LLM/tool traces to Langfuse.
# VETTA_TRACING=langfuse

# Trace name shown in Langfuse.
# VETTA_TRACING_TRACE_NAME="vetta desktop"

# Langfuse credentials.
# LANGFUSE_SECRET_KEY="sk-lf-xx"
# LANGFUSE_PUBLIC_KEY="pk-lf-xx"
# LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"

# Optional Langfuse/OpenTelemetry metadata.
# LANGFUSE_TRACING_ENVIRONMENT=production
# LANGFUSE_RELEASE=local
# OTEL_SERVICE_NAME=vetta-agent
