{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"noEmit": true,
		"paths": {
			"@/*": ["./src/*"],
			"@shared/*": ["./src/renderer/shared/*"],
			"@domains/*": ["./src/renderer/domains/*"],
			"@preload/*": ["./src/preload/*"],
			"@vetta/capability-sdk": ["../capability-sdk/src/index.ts"],
			"@vetta/capability-sdk/internal/plugin-adapter": ["../capability-sdk/src/adapters/plugin/index.ts"],
			"@vetta/capability-sdk/internal/theme-adapter": ["../capability-sdk/src/adapters/theme.ts"],
			"@vetta/capability-sdk/*": ["../capability-sdk/src/*"],
			"@vetta/capability-runtime": ["../capability-runtime/src/index.ts"],
			"@vetta/capability-runtime/*": ["../capability-runtime/src/*"],
			"@vetta/ai": ["../ai/src/index.ts"],
			"@vetta/ai/protocol": ["../ai/src/protocol/index.ts"],
			"@vetta/ai/testing": ["../ai/src/testing/index.ts"],
			"@vetta/ai/*": ["../ai/src/*"],
			"@vetta/agent-core": ["../agent/src/index.ts"],
			"@vetta/agent-core/*": ["../agent/src/*"],
			"@vetta/ecosystem-adapter": ["../ecosystem-adapter/src/index.ts"],
			"@vetta/ecosystem-adapter/hooks": ["../ecosystem-adapter/src/hooks/index.ts"],
			"@vetta/ecosystem-adapter/codex/hooks": ["../ecosystem-adapter/src/codex/hooks/index.ts"],
			"@vetta/ecosystem-adapter/*": ["../ecosystem-adapter/src/*"],
			"@vetta/coding-agent": ["../coding-agent/src/index.ts"],
			"@vetta/coding-agent/bootstrap": ["../coding-agent/src/public-api/bootstrap.ts"],
			"@vetta/coding-agent/cli-control": ["../coding-agent/src/public-api/cli-control.ts"],
			"@vetta/coding-agent/composition": ["../coding-agent/src/composition/index.ts"],
			"@vetta/coding-agent/config": ["../coding-agent/src/config.ts"],
			"@vetta/coding-agent/concurrency": ["../coding-agent/src/concurrency/index.ts"],
			"@vetta/coding-agent/extensions": ["../coding-agent/src/public-api/extensions.ts"],
			"@vetta/coding-agent/host-services": ["../coding-agent/src/public-api/host-services.ts"],
			"@vetta/coding-agent/historical-sessions": [
				"../coding-agent/src/public-api/historical-sessions.ts"
			],
			"@vetta/coding-agent/hooks": ["../coding-agent/src/public-api/hooks.ts"],
			"@vetta/coding-agent/profile": ["../coding-agent/src/public-api/profile.ts"],
			"@vetta/coding-agent/product-prompt": ["../coding-agent/src/public-api/product-prompt.ts"],
			"@vetta/coding-agent/resources": ["../coding-agent/src/public-api/resources.ts"],
			"@vetta/coding-agent/rpc": ["../coding-agent/src/public-api/rpc.ts"],
			"@vetta/coding-agent/runtime": ["../coding-agent/src/public-api/runtime.ts"],
			"@vetta/coding-agent/*": ["../coding-agent/src/*"],
			"@vetta/cli-app": ["../cli-app/src/index.ts"],
			"@vetta/cli-app/*": ["../cli-app/src/*"],
			"@vetta/runtime-core": ["../runtime-core/src/index.ts"],
			"@vetta/runtime-core/*": ["../runtime-core/src/*"],
			"@vetta/runtime-mcp": ["../runtime-mcp/src/index.ts"],
			"@vetta/runtime-mcp/*": ["../runtime-mcp/src/*"],
			"@vetta/runtime-knowledge": ["../runtime-knowledge/src/index.ts"],
			"@vetta/runtime-knowledge/*": ["../runtime-knowledge/src/*"],
			"@vetta/runtime-storage": ["../runtime-storage/src/index.ts"],
			"@vetta/runtime-storage/*": ["../runtime-storage/src/*"],
			"@vetta/runtime-subagents": ["../runtime-subagents/src/index.ts"],
			"@vetta/runtime-subagents/*": ["../runtime-subagents/src/*"],
			"@vetta/runtime-tools": ["../runtime-tools/src/index.ts"],
			"@vetta/runtime-tools/*": ["../runtime-tools/src/*"],
			"@vetta-org/plugin-sdk": ["../plugins/plugin-sdk/src/index.ts"],
			"@vetta-org/plugin-sdk/*": ["../plugins/plugin-sdk/src/*"],
			"@vetta/theme-sdk": ["../theme-sdk/src/index.ts"],
			"@vetta/theme-sdk/*": ["../theme-sdk/src/*"],
			"@vetta/theme-ui": ["../theme-ui/src/index.ts"],
			"@vetta/theme-ui/*": ["../theme-ui/src/*"],
			"@vetta/ui": ["../ui/src/index.ts"],
			"@vetta/ui/*": ["../ui/src/*"],
			"@vetta/runtime-telemetry": ["../runtime-telemetry/src/index.ts"],
			"@vetta/runtime-telemetry/langfuse": ["../runtime-telemetry/src/langfuse.ts"],
			"@vetta/runtime-telemetry/*": ["../runtime-telemetry/src/*"],
			"@vetta/action-rpc": ["../action-rpc/src/index.ts"],
			"@vetta/action-rpc/*": ["../action-rpc/src/*"],
			"@vetta/toolkit": ["../toolkit/src/index.ts"],
			"@vetta/toolkit/*": ["../toolkit/src/*"]
		},
		"allowImportingTsExtensions": true
	},
	"include": ["./**/*.ts", "./**/*.tsx", "./**/*.d.ts"],
	"exclude": ["node_modules", "../preload", "../../runtime-core", "e2e", "wdio.conf.ts"]
}
