{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@shared/*": ["./src/renderer/shared/*"],
			"@domains/*": ["./src/renderer/domains/*"],
			"@preload/*": ["./src/preload/*"],
			"@astravia/capability-sdk": ["../capability-sdk/src/index.ts"],
			"@astravia/capability-sdk/internal/plugin-adapter": ["../capability-sdk/src/adapters/plugin/index.ts"],
			"@astravia/capability-sdk/internal/theme-adapter": ["../capability-sdk/src/adapters/theme.ts"],
			"@astravia/capability-sdk/*": ["../capability-sdk/src/*"],
			"@astravia/capability-runtime": ["../capability-runtime/src/index.ts"],
			"@astravia/capability-runtime/*": ["../capability-runtime/src/*"],
			"@astravia/ai": ["../ai/src/index.ts"],
			"@astravia/ai/*": ["../ai/src/*"],
			"@astravia/agent-core": ["../agent/src/index.ts"],
			"@astravia/agent-core/*": ["../agent/src/*"],
			"@astravia/ecosystem-adapter": ["../ecosystem-adapter/src/index.ts"],
			"@astravia/ecosystem-adapter/hooks": ["../ecosystem-adapter/src/hooks/index.ts"],
			"@astravia/ecosystem-adapter/codex/hooks": ["../ecosystem-adapter/src/codex/hooks/index.ts"],
			"@astravia/ecosystem-adapter/*": ["../ecosystem-adapter/src/*"],
			"@astravia/coding-agent": ["../coding-agent/src/index.ts"],
			"@astravia/coding-agent/*": ["../coding-agent/src/*"],
			"@astravia/runtime-core": ["../runtime-core/src/index.ts"],
			"@astravia/runtime-core/*": ["../runtime-core/src/*"],
			"@astravia-org/plugin-sdk": ["../plugins/plugin-sdk/src/index.ts"],
			"@astravia-org/plugin-sdk/*": ["../plugins/plugin-sdk/src/*"],
			"@astravia/theme-sdk": ["../theme-sdk/src/index.ts"],
			"@astravia/theme-sdk/*": ["../theme-sdk/src/*"],
			"@astravia/theme-ui": ["../theme-ui/src/index.ts"],
			"@astravia/theme-ui/*": ["../theme-ui/src/*"],
			"@astravia/ui": ["../ui/src/index.ts"],
			"@astravia/ui/*": ["../ui/src/*"],
			"@astravia/runtime-telemetry": ["../runtime-telemetry/src/index.ts"],
			"@astravia/runtime-telemetry/langfuse": ["../runtime-telemetry/src/langfuse.ts"],
			"@astravia/runtime-telemetry/*": ["../runtime-telemetry/src/*"],
			"@astravia/action-rpc": ["../action-rpc/src/index.ts"],
			"@astravia/action-rpc/*": ["../action-rpc/src/*"],
			"@astravia/toolkit": ["../toolkit/src/index.ts"],
			"@astravia/toolkit/*": ["../toolkit/src/*"]
		},
		"allowImportingTsExtensions": true
	},
	"include": ["./**/*.ts", "./**/*.tsx", "./**/*.d.ts"],
	"exclude": ["node_modules", "../preload", "../../runtime-core", "e2e", "wdio.conf.ts"]
}
