{
	"id": "preset-agent",
	"name": "%plugin.name%",
	"version": "0.1.0",
	"icon": "solar:users-group-two-rounded-linear",
	"defaultLocale": "zh",
	"pluginApiVersion": "^2.0.0",
	"entry": "dist/mf-manifest.json",
	"moduleFederation": {
		"remoteName": "preset_agent",
		"expose": "./plugin"
	},
	"agent": {
		"agents": [
			{
				"id": "master",
				"name": "%agent.master.name%",
				"description": "%agent.master.description%",
				"mentionHandle": "master",
				"avatar": "agent/avatars/master.webp",
				"systemPromptPath": "agent/prompts/master.md",
				"legacyIds": [
					"master",
					"leader"
				]
			},
			{
				"id": "developer",
				"name": "%agent.developer.name%",
				"description": "%agent.developer.description%",
				"mentionHandle": "developer",
				"avatar": "agent/avatars/developer.webp",
				"systemPromptPath": "agent/prompts/developer.md",
				"legacyIds": [
					"executor",
					"builder"
				]
			},
			{
				"id": "researcher",
				"name": "%agent.researcher.name%",
				"description": "%agent.researcher.description%",
				"mentionHandle": "researcher",
				"avatar": "agent/avatars/researcher.webp",
				"systemPromptPath": "agent/prompts/researcher.md",
				"legacyIds": [
					"researcher"
				]
			},
			{
				"id": "auditor",
				"name": "%agent.auditor.name%",
				"description": "%agent.auditor.description%",
				"mentionHandle": "auditor",
				"avatar": "agent/avatars/auditor.webp",
				"systemPromptPath": "agent/prompts/auditor.md",
				"legacyIds": [
					"auditor",
					"reviewer"
				]
			},
			{
				"id": "business",
				"name": "%agent.business.name%",
				"description": "%agent.business.description%",
				"mentionHandle": "business",
				"avatar": "agent/avatars/business.webp",
				"systemPromptPath": "agent/prompts/business.md"
			}
		],
		"teams": [
			{
				"id": "dev-team",
				"name": "%team.dev.name%",
				"description": "%team.dev.description%",
				"members": [
					{
						"agent": "master",
						"responsibility": "Turns the request into a plan, drives the loop, and delivers the result."
					},
					{
						"agent": "developer",
						"responsibility": "Implements the plan and verifies that it works."
					},
					{
						"agent": "researcher",
						"responsibility": "Establishes the facts and prior art the implementation depends on."
					},
					{
						"agent": "auditor",
						"responsibility": "Reviews the result for defects, risk, and missing verification."
					}
				],
				"workflowPath": "agent/workflows/dev-team.md"
			},
			{
				"id": "planning-team",
				"name": "%team.planning.name%",
				"description": "%team.planning.description%",
				"members": [
					{
						"agent": "master",
						"responsibility": "Frames the goal and owns the delivered plan."
					},
					{
						"agent": "researcher",
						"responsibility": "Gathers the market, user, and prior-art evidence."
					},
					{
						"agent": "auditor",
						"responsibility": "Hunts for fatal flaws in the case before it ships."
					},
					{
						"agent": "business",
						"responsibility": "Turns the evidence into requirements, scope, and a business model."
					}
				],
				"workflowPath": "agent/workflows/planning-team.md"
			}
		]
	},
	"description": "%plugin.description%",
	"author": "Vetta"
}
