{
	"id": "vetta-ui-design",
	"name": "%plugin.name%",
	"version": "0.7.2",
	"icon": "icon.png",
	"defaultLocale": "zh",
	"pluginApiVersion": "^2.0.0",
	"entry": "dist/mf-manifest.json",
	"moduleFederation": {
		"remoteName": "vetta_ui_design",
		"expose": "./plugin"
	},
	"styles": [
		"dist/style.css"
	],
	"permissions": [
		"ui.slot.global",
		"ui.slot.workspace-view",
		"ui.slot.activity-tab",
		"ui.slot.file-preview",
		"ui.slot.message",
		"ui.slot.input-action",
		"ui.file-explorer.decorations",
		"ui.file-explorer.context-menu",
		"ui.shortcuts.register",
		"agent.session.read",
		"agent.session.write",
		"agent.tools.register",
		"agent.toolHandler.execute",
		"agent.hooks.register",
		"agent.hookHandler.execute",
		"agent.skills.control",
		"agent.systemPrompt.write",
		"agent.tools.control",
		"agent.command.run",
		"agent.command.spawn",
		"capture.offscreen",
		"fs.read",
		"fs.write",
		"storage.read",
		"storage.write",
		"shell.openExternal",
		"network.fetch"
	],
	"network": {
		"allowedHosts": [
			"cdn.jsdelivr.net",
			"raw.githubusercontent.com"
		]
	},
	"commands": [
		"node",
		"npm"
	],
	"agent": {
		"skillPaths": [
			"agent/skills/vetta-ui-design"
		],
		"skillPresentation": {
			"defaultVisibility": "hidden",
			"skills": {
				"vetta-ui-design": {
					"defaultVisibility": "visible",
					"displayName": "%plugin.name%"
				}
			}
		},
		"agents": [
			{
				"id": "designer",
				"name": "%agent.designer.name%",
				"description": "%agent.designer.description%",
				"mentionHandle": "designer",
				"avatar": "agent/agents/designer.webp",
				"systemPromptPath": "agent/agents/designer.md",
				"abilities": "all"
			}
		],
		"teams": [
			{
				"id": "design-team",
				"name": "%agent.designTeam.name%",
				"description": "%agent.designTeam.description%",
				"members": [
					{
						"agent": "builtin:master",
						"responsibility": "Frames the design brief, drives the loop, and delivers the design document."
					},
					{
						"agent": "builtin:architect",
						"responsibility": "Defines the screen inventory, flows, and states before anything is drawn."
					},
					{
						"agent": "designer",
						"responsibility": "Builds the frames on the Vetta canvas and keeps the visual system consistent."
					},
					{
						"agent": "builtin:auditor",
						"responsibility": "Reviews the screens for usability, missing states, and inconsistent visuals."
					}
				],
				"workflowPath": "agent/agents/design-team.md"
			}
		]
	},
	"description": "%plugin.description%",
	"author": "Vetta"
}
