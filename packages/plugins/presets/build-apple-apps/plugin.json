{
	"id": "build-apple-apps",
	"name": "%plugin.name%",
	"version": "0.1.1",
	"icon": "solar:smartphone-2-linear",
	"defaultLocale": "zh",
	"pluginApiVersion": "^2.0.0",
	"entry": "dist/mf-manifest.json",
	"moduleFederation": {
		"remoteName": "build_apple_apps",
		"expose": "./plugin"
	},
	"styles": [
		"dist/style.css"
	],
	"permissions": [
		"ui.slot.activity-tab",
		"ui.slot.workspace-view",
		"agent.command.run",
		"agent.command.spawn",
		"agent.skills.control",
		"agent.session.read",
		"fs.read",
		"storage.read",
		"storage.write",
		"shell.openExternal"
	],
	"commands": [
		"baguette"
	],
	"agent": {
		"skillPaths": [
			"agent/skills/vetta-apple-app-dev-guide"
		]
	},
	"description": "%plugin.description%",
	"author": "Vetta"
}
