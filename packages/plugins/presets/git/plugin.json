{
	"id": "git",
	"name": "%plugin.name%",
	"icon": "icon.png",
	"version": "0.3.0",
	"defaultLocale": "zh",
	"pluginApiVersion": "^2.0.0",
	"entry": "dist/mf-manifest.json",
	"moduleFederation": {
		"remoteName": "git",
		"expose": "./plugin"
	},
	"styles": ["dist/style.css"],
	"permissions": [
		"ui.slot.activity-tab",
		"ui.slot.turn-card",
		"ui.slot.workspace-view",
		"agent.session.read",
		"agent.command.run",
		"fs.read",
		"ai.complete",
		"ai.models.list",
		"storage.read",
		"storage.write",
		"fs.write"
	],
	"commands": ["git"],
	"description": "%plugin.description%",
	"author": "Vetta"
}
