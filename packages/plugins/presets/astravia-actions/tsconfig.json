{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "bundler",
		"baseUrl": ".",
		"paths": {
			"@astravia-org/plugin-sdk": ["../../plugin-sdk/src/index.ts"]
		},
		"isolatedModules": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts"]
}
