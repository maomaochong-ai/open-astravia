{
	"id": "image-gen",
	"name": "%plugin.name%",
	"icon": "icon.png",
	"version": "0.3.0",
	"pluginApiVersion": "^1.0.0",
	"runtime": "module-federation",
	"entry": "dist/mf-manifest.json",
	"moduleFederation": {
		"remoteName": "image_gen",
		"expose": "./plugin"
	},
	"styles": [
		"dist/style.css"
	],
	"permissions": [
		"ui.slot.input-action",
		"ui.slot.message",
		"ui.slot.activity-tab",
		"agent.tools.register",
		"agent.toolHandler.execute",
		"storage.read",
		"storage.write",
		"media.generate",
		"fs.read"
	],
	"description": "%plugin.description%",
	"author": "Vetta",
	"defaultLocale": "zh",
	"guidingWords": []
}
