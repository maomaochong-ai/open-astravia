{
	"name": "@vetta-org/plugin-vite",
	"version": "0.0.5",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"vetta-plugin": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./cli": "./dist/cli.js",
		"./pack": {
			"types": "./dist/pack.d.ts",
			"import": "./dist/pack.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run"
	},
	"dependencies": {
		"@module-federation/vite": "^1.16.6",
		"@vitejs/plugin-react": "^5.0.4",
		"chokidar": "^4.0.3",
		"postcss": "^8.5.15",
		"postcss-selector-parser": "^7.1.4"
	},
	"peerDependencies": {
		"@vetta-org/plugin-sdk": ">=0.1.1 <0.2.0",
		"vite": "^7.0.0"
	},
	"devDependencies": {
		"@vetta-org/plugin-sdk": "workspace:*",
		"typescript": "^5.9.2",
		"vite": "^7.1.7",
		"vitest": "^3.2.4"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
