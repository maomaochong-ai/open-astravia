{
	"name": "@vetta-org/plugin-sdk",
	"version": "0.3.9",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./manifest": {
			"types": "./dist/manifest.d.ts",
			"import": "./dist/manifest.js"
		},
		"./npm-package": {
			"types": "./dist/npm-package.d.ts",
			"import": "./dist/npm-package.js"
		},
		"./logger": {
			"types": "./dist/logger.d.ts",
			"import": "./dist/logger.js"
		},
		"./tailwind-theme.css": "./src/tailwind-theme.css"
	},
	"files": [
		"dist",
		"docs",
		"src/tailwind-theme.css"
	],
	"scripts": {
		"clean": "rm -rf dist docs",
		"bundle-docs": "node scripts/bundle-docs.mjs",
		"build": "tsgo -p tsconfig.build.json && node scripts/bundle-docs.mjs",
		"prepack": "node scripts/bundle-docs.mjs"
	},
	"dependencies": {
		"@vetta-org/capability-sdk": "^0.1.0",
		"@sinclair/typebox": "^0.34.41"
	},
	"peerDependencies": {
		"react": "^19.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/react": "^19.1.1",
		"typescript": "^5.9.2"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
