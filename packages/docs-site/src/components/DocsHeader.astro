---
import { ChevronsUpDown, NotebookTabs } from "lucide-astro";
import Search from "@astrojs/starlight/components/Search.astro";
import packageJson from "../../package.json";
---

<div class="docs-header">
	<div class="docs-brand-row">
		<a class="docs-brand" href={import.meta.env.BASE_URL} aria-label="Vetta 文档首页">
			<span class="docs-brand__mark"><NotebookTabs size={23} stroke-width={1.55} aria-hidden="true" /></span>
			<span class="docs-brand__text">
				<strong>Vetta 文档</strong>
				<small>v{packageJson.version}</small>
			</span>
		</a>
		<ChevronsUpDown class="docs-brand__switch" size={16} stroke-width={1.8} aria-hidden="true" />
	</div>
	<div class="docs-header__search"><Search /></div>
</div>

<style>
	@layer starlight.core {
		.docs-header {
			display: flex;
			align-items: center;
			height: 100%;
			padding: 0.7rem 4.25rem 0.7rem 1rem;
		}

		.docs-brand-row {
			display: flex;
			align-items: center;
			min-width: 0;
		}

		.docs-brand {
			display: flex;
			align-items: center;
			gap: 0.7rem;
			min-width: 0;
			color: var(--sl-color-white);
			text-decoration: none;
		}

		.docs-brand__mark {
			display: grid;
			flex: 0 0 auto;
			width: 2.7rem;
			height: 2.7rem;
			place-items: center;
			border-radius: 7px;
			background: #111211;
			color: #ffffff;
			overflow: hidden;
		}

		.docs-brand__text {
			display: grid;
			min-width: 0;
			line-height: 1.18;
		}

		.docs-brand__text strong {
			overflow: hidden;
			font-size: 0.94rem;
			font-weight: 690;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.docs-brand__text small {
			margin-top: 0.18rem;
			color: var(--sl-color-gray-3);
			font-size: 0.72rem;
		}

		.docs-brand__switch {
			display: none;
			margin-inline-start: auto;
			color: var(--sl-color-gray-2);
		}

		.docs-header__search {
			margin-inline-start: auto;
		}

		@media (min-width: 50rem) {
			.docs-header {
				display: block;
				height: auto;
				padding: 1.2rem 1.15rem 0.85rem;
			}

			.docs-brand__switch {
				display: block;
			}

			.docs-header__search {
				margin: 1.15rem 0 0;
			}

			.docs-header__search :global(site-search),
			.docs-header__search :global(button[data-open-modal]) {
				width: 100%;
				max-width: none;
			}
		}
	}
</style>
