---
import { ChevronRight } from "lucide-astro";
import MobileMenuToggle from "@astrojs/starlight/components/MobileMenuToggle.astro";

const { entry, hasSidebar } = Astro.locals.starlightRoute;
const currentTitle = entry.slug === "index" ? "文档中心" : entry.data.title;
---

<div class="docs-stage">
	<div class="docs-shell">
		<aside class="docs-rail print:hidden">
			<div class="docs-rail__header"><slot name="header" /></div>
			{
				hasSidebar && (
					<nav class="docs-rail__nav" aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}>
						<MobileMenuToggle />
						<div id="starlight__sidebar" class="docs-sidebar-pane">
							<div class="docs-sidebar-content"><slot name="sidebar" /></div>
						</div>
					</nav>
				)
			}
		</aside>

		<section class="docs-workspace">
			<div class="docs-breadcrumb print:hidden" aria-label="当前位置">
				<a href={import.meta.env.BASE_URL}>Vetta</a>
				<ChevronRight size={15} stroke-width={1.8} aria-hidden="true" />
				<span>{currentTitle}</span>
			</div>
			<div class="docs-main-frame"><slot /></div>
		</section>
	</div>
</div>

<style>
	@layer starlight.core {
		.docs-stage {
			min-height: 100vh;
			background: var(--docs-canvas);
		}

		.docs-shell {
			min-height: 100vh;
			background: var(--sl-color-bg);
		}

		.docs-rail__header {
			position: fixed;
			z-index: var(--sl-z-index-navbar);
			inset: 0 0 auto;
			height: var(--sl-nav-height);
			border-bottom: 1px solid var(--sl-color-hairline);
			background: var(--sl-color-bg-sidebar);
		}

		.docs-sidebar-pane {
			visibility: var(--sl-sidebar-visibility, hidden);
			position: fixed;
			z-index: var(--sl-z-index-menu);
			inset: var(--sl-nav-height) 0 0;
			background: var(--sl-color-bg-sidebar);
			overflow-y: auto;
		}

		:global([aria-expanded="true"]) ~ .docs-sidebar-pane {
			--sl-sidebar-visibility: visible;
		}

		.docs-sidebar-content {
			min-height: 100%;
		}

		.docs-breadcrumb {
			display: none;
		}

		.docs-main-frame {
			padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
		}

		@media (min-width: 50rem) {
			.docs-shell {
				display: grid;
				grid-template-columns: var(--sl-sidebar-width) minmax(0, 1fr);
				min-height: 100vh;
			}

			.docs-rail {
				position: relative;
				min-width: 0;
				border-inline-end: 1px solid var(--sl-color-hairline);
				background: var(--sl-color-bg-sidebar);
			}

			.docs-rail__header {
				position: static;
				height: auto;
				border-bottom: 0;
			}

			.docs-sidebar-pane {
				--sl-sidebar-visibility: visible;
				position: static;
				width: auto;
				height: auto;
				max-height: calc(100vh - 8.1rem);
				border: 0;
			}

			.docs-workspace {
				min-width: 0;
				border: 1px solid var(--sl-color-hairline);
				border-width: 1px 0 0 1px;
				border-radius: 9px 0 0;
				background: var(--sl-color-bg);
				overflow: hidden;
			}

			.docs-breadcrumb {
				display: flex;
				align-items: center;
				gap: 0.65rem;
				height: 4.7rem;
				padding-inline: clamp(2rem, 4vw, 3.75rem);
				border-bottom: 1px solid var(--sl-color-hairline-light);
				color: var(--sl-color-gray-3);
				font-size: 0.9rem;
				font-weight: 530;
			}

			.docs-breadcrumb a {
				color: var(--sl-color-gray-2);
				text-decoration: none;
			}

			.docs-breadcrumb span {
				color: var(--sl-color-gray-1);
				font-weight: 620;
			}

			.docs-main-frame {
				padding-top: 0;
			}
		}
	}
</style>
