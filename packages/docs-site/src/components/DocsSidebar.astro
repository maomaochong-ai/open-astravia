---
import {
	ArrowUpRight,
	Bell,
	BookOpen,
	Boxes,
	CircleHelp,
	CirclePlay,
	Code2,
	FileText,
	Gauge,
	Github,
	Grid2X2,
	LifeBuoy,
	Puzzle,
	ShieldCheck,
	SquareTerminal,
	Webhook,
} from "lucide-astro";

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== "/" && path.startsWith(href));

const menuItems = [
	{ label: "快速开始", href: "/getting-started/", icon: CirclePlay },
	{ label: "运行第一个任务", href: "/getting-started/first-task/", icon: SquareTerminal },
	{ label: "产品能力", href: "/product/overview/", icon: Grid2X2, expandable: true },
	{ label: "插件开发", href: "/plugins/getting-started/", icon: Code2, expandable: true },
	{ label: "插件概览", href: "/plugins/overview/", icon: Puzzle, expandable: true },
	{ label: "架构指南", href: "/developers/architecture/", icon: BookOpen, expandable: true },
	{ label: "自动化与事件", href: "/product/overview/", icon: Bell },
	{ label: "扩展集成", href: "/plugins/overview/", icon: Webhook },
	{ label: "运行限制", href: "/reference/documentation-policy/", icon: Gauge },
	{ label: "安全与边界", href: "/developers/architecture/", icon: ShieldCheck },
	{ label: "文档范围", href: "/reference/documentation-policy/", icon: FileText },
	{ label: "常见问题", href: "/troubleshooting/", icon: CircleHelp },
	{ label: "支持", href: "/troubleshooting/", icon: LifeBuoy },
];
---

<div class="docs-sidebar">
	<div class="docs-shortcuts">
		<a class:list={["docs-shortcut", { active: path === "/" }]} href="/">
			<span class="docs-shortcut__icon"><FileText size={16} stroke-width={1.75} /></span>
			<strong>文档中心</strong>
		</a>
		<a class:list={["docs-shortcut", { active: path.startsWith("/product/") }]} href="/product/overview/">
			<span class="docs-shortcut__icon"><Boxes size={16} stroke-width={1.75} /></span>
			<strong>产品能力</strong>
			<span class="docs-shortcut__badge">Hot</span>
		</a>
		<a class:list={["docs-shortcut", { active: path.startsWith("/developers/") }]} href="/developers/architecture/">
			<span class="docs-shortcut__icon"><Github size={16} stroke-width={1.75} /></span>
			<strong>开发者指南</strong>
			<ArrowUpRight class="docs-shortcut__external" size={15} stroke-width={1.7} />
		</a>
	</div>

	<p class="docs-menu-label">菜单</p>
	<ul class="docs-menu">
		{
			menuItems.map((item) => {
				const ItemIcon = item.icon;
				return (
					<li>
						<a class:list={["docs-menu__link", { active: isActive(item.href) }]} href={item.href}>
							<ItemIcon size={17} stroke-width={1.75} aria-hidden="true" />
							<span>{item.label}</span>
							{item.expandable && <span class="docs-menu__chevron">›</span>}
						</a>
					</li>
				);
			})
		}
	</ul>

</div>

<style>
	@layer starlight.core {
		.docs-sidebar {
			display: flex;
			min-height: 100%;
			padding: 0 1.15rem 1.2rem;
			flex-direction: column;
		}

		.docs-shortcuts {
			border-top: 1px dashed var(--sl-color-hairline);
		}

		.docs-shortcut {
			display: flex;
			align-items: center;
			gap: 0.75rem;
			min-height: 4rem;
			border-bottom: 1px dashed var(--sl-color-hairline);
			color: var(--sl-color-gray-1);
			text-decoration: none;
		}

		.docs-shortcut:hover strong,
		.docs-shortcut.active strong {
			color: var(--sl-color-white);
		}

		.docs-shortcut__icon {
			display: grid;
			flex: 0 0 auto;
			width: 2rem;
			height: 2rem;
			place-items: center;
			border: 1px solid var(--sl-color-hairline);
			border-radius: 6px;
			background: var(--sl-color-bg);
			box-shadow: 0 2px 5px rgb(22 25 23 / 7%);
		}

		.docs-shortcut strong {
			font-size: 0.87rem;
			font-weight: 620;
		}

		.docs-shortcut__badge {
			margin-inline-start: auto;
			padding: 0.18rem 0.6rem;
			border-radius: 999px;
			background: #ff8f48;
			color: white;
			font-size: 0.69rem;
			font-weight: 650;
		}

		.docs-shortcut__external {
			margin-inline-start: auto;
			color: var(--sl-color-gray-3);
		}

		.docs-menu-label {
			margin: 1.45rem 0 0.55rem;
			color: var(--sl-color-gray-3);
			font-size: 0.72rem;
			font-weight: 580;
		}

		.docs-menu {
			display: grid;
			gap: 0.12rem;
			margin: 0;
			padding: 0;
			list-style: none;
		}

		.docs-menu__link {
			display: grid;
			grid-template-columns: 1.25rem minmax(0, 1fr) auto;
			align-items: center;
			gap: 0.55rem;
			min-height: 2.55rem;
			padding: 0.42rem 0.18rem;
			border-radius: 5px;
			color: var(--sl-color-gray-2);
			font-size: 0.84rem;
			font-weight: 520;
			text-decoration: none;
		}

		.docs-menu__link:hover,
		.docs-menu__link.active {
			background: var(--sl-color-gray-6);
			color: var(--sl-color-white);
		}

		.docs-menu__link svg {
			justify-self: center;
		}

		.docs-menu__chevron {
			padding-inline: 0.3rem;
			font-size: 1.2rem;
			line-height: 1;
		}

		@media (min-width: 50rem) {
			.docs-sidebar {
				padding-bottom: 1rem;
			}
		}
	}
</style>
