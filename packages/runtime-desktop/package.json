{
	"name": "@vetta/runtime-desktop",
	"version": "0.0.1",
	"description": "Desktop platform runtime composition and host adapters for Vetta agents",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": ["dist", "README.md"],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "bun ../../scripts/quality/run-vitest.mjs --run --config vitest.config.ts",
		"prepublishOnly": "bun run clean && bun run build"
	},
	"dependencies": {
		"@vetta/ai": "workspace:*",
		"@vetta/coding-agent": "workspace:*",
		"@vetta/runtime-core": "workspace:*",
		"@vetta/runtime-mcp": "workspace:*",
		"@vetta/runtime-node": "workspace:*",
		"@vetta/runtime-storage": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22.10.5",
		"typescript": "^5.9.2",
		"vitest": "^3.2.4"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
