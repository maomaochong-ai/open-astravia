{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetta uses the camera to scan the QR code on your computer to pair."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetta 需要使用相机扫描电脑端的二维码来完成配对。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetta needs local network access to connect directly to your computer on the same Wi-Fi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetta 需要访问本地网络，才能在同一 Wi-Fi 下直接连接你的电脑。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
