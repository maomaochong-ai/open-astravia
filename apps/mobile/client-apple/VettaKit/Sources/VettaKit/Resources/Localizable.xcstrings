    "pair.troubleshoot.firewall": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first time you enable phone connections, macOS shows a firewall prompt. Click “Allow”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 第一次开启手机连接时会弹出防火墙提示，请点「允许」。"
          }
        }
      }
    },
    "pair.troubleshoot.localNetwork": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On first connection, iPhone asks for Local Network access. Allow it; if you declined, turn it back on in Settings → Vetta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 首次连接会询问「本地网络」权限，请选择允许；拒绝后可到 设置 → Vetta 里重新打开。"
          }
        }
      }
    },
    "pair.troubleshoot.relay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The QR code carries both a LAN address and a cloud relay address. If the LAN is unreachable, the relay is used automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑端二维码里带有局域网地址和云端中继地址，局域网连不上时会自动改走中继。"
          }
        }
      }
    },
    "pair.troubleshoot.sameWifi": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone and computer must be on the same Wi-Fi. Guest networks usually isolate devices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机和电脑要在同一个 Wi-Fi 下，访客网络通常会隔离设备。"
          }
        }
      }
    },
