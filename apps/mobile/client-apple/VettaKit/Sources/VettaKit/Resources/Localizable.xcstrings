    "settings.unpairConfirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unpair from this computer? Only the sessions cached on this phone are cleared; your sessions on the computer stay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解除与这台电脑的配对？只会清除这部手机上缓存的会话，电脑上的会话不受影响。"
          }
        }
      }
    },
    "settings.unpairHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes this computer's credentials and the sessions cached on this phone; the sessions on the computer stay. You'll need to scan again to reconnect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除这台电脑的连接凭据和手机上缓存的会话，电脑上的会话不受影响。之后需要重新扫码才能连接。"
          }
        }
      }
    },
