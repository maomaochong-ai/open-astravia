{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"noEmit": true,
		"paths": {
			"@/*": ["./src/*"],
			"@shared/*": ["./src/renderer/shared/*"],
			"@domains/*": ["./src/renderer/domains/*"],
			"@cloud/*": ["./src/renderer/cloud/*"],
			"@preload/*": ["./src/preload/*"],
			"@vetta/capability-sdk": ["../../packages/capability-sdk/src/index.ts"],
			"@vetta/capability-sdk/*": ["../../packages/capability-sdk/src/*"],
			"@vetta/capability-runtime": ["../../packages/capability-runtime/src/index.ts"],
			"@vetta/capability-runtime/*": ["../../packages/capability-runtime/src/*"],
			"@vetta/ai": ["../../packages/ai/src/index.ts"],
			"@vetta/ai/protocol": ["../../packages/ai/src/protocol/index.ts"],
			"@vetta/ai/testing": ["../../packages/ai/src/testing/index.ts"],
			"@vetta/ai/*": ["../../packages/ai/src/*"],
			"@vetta/agent-core": ["../../packages/agent/src/index.ts"],
			"@vetta/agent-core/*": ["../../packages/agent/src/*"],
			"@vetta/ecosystem-adapter": ["../../packages/ecosystem-adapter/src/index.ts"],
			"@vetta/ecosystem-adapter/hooks": ["../../packages/ecosystem-adapter/src/hooks/index.ts"],
			"@vetta/ecosystem-adapter/codex/hooks": ["../../packages/ecosystem-adapter/src/codex/hooks/index.ts"],
			"@vetta/ecosystem-adapter/*": ["../../packages/ecosystem-adapter/src/*"],
			"@vetta/coding-agent": ["../../packages/coding-agent/src/index.ts"],
			"@vetta/coding-agent/bootstrap": ["../../packages/coding-agent/src/public-api/bootstrap.ts"],
			"@vetta/coding-agent/composition": ["../../packages/coding-agent/src/composition/index.ts"],
			"@vetta/coding-agent/model-context": ["../../packages/coding-agent/src/public-api/model-context.ts"],
			"@vetta/coding-agent/session-extensions": ["../../packages/coding-agent/src/public-api/session-extensions.ts"],
			"@vetta/coding-agent/config": ["../../packages/coding-agent/src/config.ts"],
			"@vetta/coding-agent/extensions": ["../../packages/coding-agent/src/public-api/extensions.ts"],
			"@vetta/coding-agent/function-extensions": [
				"../../packages/coding-agent/src/public-api/function-extensions.ts"
			],
			"@vetta/coding-agent/host": ["../../packages/coding-agent/src/host/tool-environment/node/index.ts"],
			"@vetta/coding-agent/host-services": ["../../packages/coding-agent/src/public-api/host-services.ts"],
			"@vetta/coding-agent/historical-sessions": [
				"../../packages/coding-agent/src/public-api/historical-sessions.ts"
			],
			"@vetta/coding-agent/hooks": ["../../packages/coding-agent/src/public-api/hooks.ts"],
			"@vetta/coding-agent/profile": ["../../packages/coding-agent/src/public-api/profile.ts"],
			"@vetta/coding-agent/plugin-runtime": ["../../packages/coding-agent/src/public-api/plugin-runtime.ts"],
			"@vetta/coding-agent/cli-guidance": ["../../packages/coding-agent/src/public-api/cli-guidance.ts"],
			"@vetta/coding-agent/resources": ["../../packages/coding-agent/src/public-api/resources.ts"],
			"@vetta/coding-agent/rpc": ["../../packages/coding-agent/src/public-api/rpc.ts"],
			"@vetta/coding-agent/runtime": ["../../packages/coding-agent/src/public-api/runtime.ts"],
			"@vetta/coding-agent/settings": ["../../packages/coding-agent/src/public-api/settings.ts"],
			"@vetta/coding-agent/*": ["../../packages/coding-agent/src/*"],
			"@vetta/cli-host": ["../cli-host/src/index.ts"],
			"@vetta/cli-host/*": ["../cli-host/src/*"],
			"@vetta/runtime-core": ["../../packages/runtime-core/src/index.ts"],
			"@vetta/runtime-core/session-extensions": ["../../packages/runtime-core/src/session-extensions/index.ts"],
			"@vetta/runtime-core/*": ["../../packages/runtime-core/src/*"],
			"@vetta/runtime-desktop": ["../../packages/runtime-desktop/src/index.ts"],
			"@vetta/runtime-desktop/*": ["../../packages/runtime-desktop/src/*"],
			"@vetta/runtime-mcp": ["../../packages/runtime-mcp/src/index.ts"],
			"@vetta/runtime-mcp/*": ["../../packages/runtime-mcp/src/*"],
			"@vetta/runtime-knowledge": ["../../packages/runtime-knowledge/src/index.ts"],
			"@vetta/runtime-knowledge/*": ["../../packages/runtime-knowledge/src/*"],
			"@vetta/runtime-storage": ["../../packages/runtime-storage/src/index.ts"],
			"@vetta/runtime-storage/*": ["../../packages/runtime-storage/src/*"],
			"@vetta/runtime-node": ["../../packages/runtime-node/src/index.ts"],
			"@vetta/runtime-node/coding": ["../../packages/runtime-node/src/coding/index.ts"],
			"@vetta/runtime-node/mcp": ["../../packages/runtime-node/src/mcp/index.ts"],
			"@vetta/runtime-node/host": ["../../packages/runtime-node/src/host/index.ts"],
			"@vetta/runtime-node/sandbox": ["../../packages/runtime-node/src/sandbox/index.ts"],
			"@vetta/runtime-node/*": ["../../packages/runtime-node/src/*"],
			"@vetta/runtime-subagents": ["../../packages/runtime-subagents/src/index.ts"],
			"@vetta/runtime-subagents/*": ["../../packages/runtime-subagents/src/*"],
			"@vetta/runtime-tools": ["../../packages/runtime-tools/src/index.ts"],
			"@vetta/runtime-tools/*": ["../../packages/runtime-tools/src/*"],
			"@vetta-org/plugin-sdk": ["../../packages/plugins/plugin-sdk/src/index.ts"],
			"@vetta-org/plugin-sdk/*": ["../../packages/plugins/plugin-sdk/src/*"],
			"@vetta/theme-sdk": ["../../packages/theme-sdk/src/index.ts"],
			"@vetta/theme-sdk/*": ["../../packages/theme-sdk/src/*"],
			"@vetta/theme-ui": ["../../packages/theme-ui/src/index.ts"],
			"@vetta/theme-ui/*": ["../../packages/theme-ui/src/*"],
			"@vetta/ui": ["../../packages/ui/src/index.ts"],
			"@vetta/ui/*": ["../../packages/ui/src/*"],
			"@vetta/runtime-telemetry": ["../../packages/runtime-telemetry/src/index.ts"],
			"@vetta/runtime-telemetry/langfuse": ["../../packages/runtime-telemetry/src/langfuse.ts"],
			"@vetta/runtime-telemetry/*": ["../../packages/runtime-telemetry/src/*"],
			"@vetta/action-rpc": ["../../packages/action-rpc/src/index.ts"],
			"@vetta/action-rpc/*": ["../../packages/action-rpc/src/*"],
			"@vetta/remote-control": ["../../packages/remote-control/src/index.ts"],
			"@vetta/remote-control/*": ["../../packages/remote-control/src/*"],
			"@vetta/remote-desktop": ["../../packages/remote-desktop/src/index.ts"],
			"@vetta/remote-desktop/*": ["../../packages/remote-desktop/src/*"],
			"@vetta/toolkit": ["../../packages/toolkit/src/index.ts"],
			"@vetta/toolkit/*": ["../../packages/toolkit/src/*"]
		},
		"allowImportingTsExtensions": true
	},
	"include": ["./**/*.ts", "./**/*.tsx", "./**/*.d.ts"],
	"exclude": ["node_modules", "../preload", "../../runtime-core", "e2e", "wdio.conf.ts"]
}
