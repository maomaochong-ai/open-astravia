# ============================================================================
# Vetta Desktop 环境变量
#
# 本文件按【两种构建模式】组织。先确定要构建哪一种，再看对应小节。
#
#   模式 A · 完全体（接入 Vetta Serv）  默认，什么都不设就是这个
#   模式 B · lite（Serv-less）          VETTA_CLOUD_ENABLED=false
#
# 用法：复制为 .env.development 后修改（该文件已被 git 忽略）。
# 优先级：命令行内联 > .env.<mode> > .env > 代码默认值。
# 打包时用 VETTA_BUILD_ENV=<mode> 指定加载哪个 .env.<mode>。
#
# ⚠️ 机密（证书、私钥、Auth Token、云厂商凭据）一律不写入任何 .env 文件，
#    只通过 shell 环境或 CI Secret 注入。清单见文末「机密变量」。
# ============================================================================


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  模式对照                                                                 ║
# ╚══════════════════════════════════════════════════════════════════════════╝
#
#                            模式 A 完全体        模式 B lite
#   ──────────────────────────────────────────────────────────────────────
#   账号登录 / OAuth          ✅                  ❌ 代码不进产物
#   Vetta Go 模型渠道         ✅                  ❌
#   订阅 / 积分 / 配额        ✅                  ❌
#   能力广场来源              官方市场             GitHub 仓库
#   远程模型目录下发          ✅                  ❌
#   内置技能                  全部                 不含 requiresCloud 标记的
#
#   两种模式共有：本地会话、编码 Agent、插件系统、主题、
#                 自带 API Key 的模型、IM 旁路、知识库
#
#   ⚠️ VETTA_CLOUD_ENABLED 是【构建期】开关，经常量折叠写死进产物。
#      发包之后无法由运行环境重新开启，切换必须重新构建。


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  模式 A · 完全体（接入 Vetta Serv）                                        ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# 云服务开关。默认即为完全体，这一行可以不写。
# VETTA_CLOUD_ENABLED=true

# 服务端 API 端点。
VETTA_SERVER_URL=https://api.openvetta.com/api/v1

# 站点地址，用于 OAuth 登录跳转。
# 不设时从 VETTA_SERVER_URL 推导：去掉 api. 前缀、端口 8080 换 3000。
# VETTA_SITE_URL=https://www.openvetta.com


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  模式 B · lite（Serv-less，不接服务端）                                    ║
# ╚══════════════════════════════════════════════════════════════════════════╝
#
# 以下两行配套使用：关掉云服务，同时给能力广场指定一个 GitHub 来源，
# 否则 lite 构建的能力广场会是空的（官方市场来源已被裁掉）。
#
# VETTA_CLOUD_ENABLED=false
# VETTA_OPEN_MARKETPLACE_REPOSITORY=https://github.com/openvetta/vetta-official-marketplace

# 可选：指定分支/标签，以及直接给出归档地址（省略时由仓库与 REF 推导）。
# VETTA_OPEN_MARKETPLACE_REF=main
# VETTA_OPEN_MARKETPLACE_ARCHIVE_URL=https://github.com/owner/repository/archive/refs/heads/main.zip
#
# ⚠️ lite 模式下 VETTA_SERVER_URL 仍然必须填写。
#    它在 lite 下已无实际消费方（登录、网关、官方市场都被裁掉了），
#    但当前实现（src/main/constants.ts）在启动时无条件校验，缺失会直接抛错。
#    填任意合法 URL 即可，例如上面模式 A 的默认值。


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  两种模式共用                                                             ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ─── 开发期开关 ──────────────────────────────────────────────────────────────

# 外观设置里的「界面主题」区段（default / xianxia）。默认不展示。
# 也可命令行内联：VETTA_SHOW_UI_THEME=true bun run dev
# VETTA_SHOW_UI_THEME=true

# 系统插件租户：决定当前 development / production profile 包含哪些 preset 插件。
# 取值见 packages/plugins/tenants.json（如 common），缺省取该文件的 default。
# profile 由 dev / pack 脚本自动设置，日常不应在 .env 中覆盖。
# 也可命令行内联覆盖（优先级最高）：VETTA_TENANT=common bun run dev
# VETTA_TENANT=common

# ─── 构建期裁剪 ──────────────────────────────────────────────────────────────

# Windows 本地语音输入，只接受 true / false，未设置时默认开启。
# 设为 false 后，完整构建不含语音模型、Sherpa 原生运行时与语音功能入口。
VETTA_SPEECH_INPUT_ENABLED=true

# ─── 自动更新源 ──────────────────────────────────────────────────────────────
#
# 更新源是构建配置，与操作系统无关；切换 provider 无需修改客户端代码。

# none | generic | github
VETTA_UPDATE_PROVIDER=generic

# generic 适用于 R2、自建对象存储或任意静态 HTTP/CDN 根路径。
# 本地更新闭环测试改用 https://releases.openvetta.com/desktop/test
VETTA_UPDATE_URL=https://releases.openvetta.com/desktop/stable

# github provider 适用于开源分发。
# VETTA_UPDATE_GITHUB_OWNER=owner
# VETTA_UPDATE_GITHUB_REPO=repository

# R2 上传目标，仅供 publish:updates:r2 使用（凭据见文末「机密变量」）。
# 本地更新闭环测试改用 VETTA_R2_PREFIX=desktop/test
# VETTA_R2_BUCKET=vetta-releases
# VETTA_R2_PREFIX=desktop/stable

# ─── 可观测性：Sentry（错误、崩溃、性能）─────────────────────────────────────

# 未配置 DSN 时 Sentry 为 Noop。DSN 会进入桌面构建产物。
# VETTA_SENTRY_DSN=https://public-key@your-sentry.example.com/project-id

# 每次正式构建使用不可变 release，运行时与 Source Map 上传必须完全一致。
# 推荐格式：vetta-desktop@<version>+<build-id>
# VETTA_SENTRY_RELEASE=vetta-desktop@0.0.0+local

# 推荐取值：development / staging / production
# VETTA_TELEMETRY_ENVIRONMENT=development

# performance tracing 采样率，0～1；缺省 0，不自动开启性能采样。
# VETTA_SENTRY_TRACES_SAMPLE_RATE=0

# Source Map 上传（仅 CI / release 构建）：以下两项与文末的 AUTH_TOKEN、
# 以及上面的 VETTA_SENTRY_RELEASE 同时存在时，才生成并上传 hidden Source Map。
# VETTA_SENTRY_ORG=your-org-slug
# VETTA_SENTRY_PROJECT=your-project-slug

# 仅自托管 Sentry 需要；Sentry SaaS 不设置。
# VETTA_SENTRY_URL=https://sentry.example.com

# 不上传 Sentry、仅本地调试 Main 堆栈时，可单独生成 Main Source Map。
# VETTA_MAIN_SOURCEMAP=true

# ─── 可观测性：PostHog（产品分析、Feature Flag、Replay）──────────────────────

# 使用 Project API Key（通常以 phc_ 开头），不要用 Personal API Key。
# 未配置时 PostHog 为 Noop。Project API Key 会进入 Renderer 构建产物。
# VETTA_POSTHOG_KEY=phc_xxx

# PostHog Cloud US；EU 或自托管请替换为对应 ingest host。
# VETTA_POSTHOG_HOST=https://us.i.posthog.com

# Replay 默认关闭，只有设为 true 才允许录制。
# VETTA_POSTHOG_REPLAY_ENABLED=false

# Replay 采样率，0～1；未设置时由 PostHog 项目端配置决定。
# VETTA_POSTHOG_REPLAY_SAMPLE_RATE=0.05

# ─── 可观测性：Langfuse（Agent / LLM / 工具调用全链路 trace）─────────────────
#
# 默认关闭。只有需要把完整 trace 发往 Langfuse 时才取消注释整段。

# VETTA_TRACING=langfuse

# Langfuse 中显示的 trace 名称。
# VETTA_TRACING_TRACE_NAME="vetta desktop"

# LANGFUSE_PUBLIC_KEY="pk-lf-xx"
# LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"

# 可选的 Langfuse / OpenTelemetry 元数据。
# LANGFUSE_TRACING_ENVIRONMENT=production
# LANGFUSE_RELEASE=local
# OTEL_SERVICE_NAME=vetta-agent


# ============================================================================
# 机密变量 —— 以下变量不要写入任何 .env 文件
#
# 只通过 shell 环境或 CI Secret 注入。本地正式测试可临时 export，用完清除。
#
#   Cloudflare R2 上传凭据（publish:updates:r2）
#     VETTA_R2_ACCOUNT_ID · VETTA_R2_ACCESS_KEY_ID · VETTA_R2_SECRET_ACCESS_KEY
#
#   macOS 代码签名与公证（dist:mac）
#     CSC_LINK · CSC_KEY_PASSWORD · APPLE_ID · APPLE_TEAM_ID · APPLE_API_*
#     CI 变体：MACOS_CERTIFICATE_P12_BASE64 · MACOS_CERTIFICATE_PASSWORD ·
#              APPLE_API_KEY_P8_BASE64 · APPLE_API_KEY_ID · APPLE_API_ISSUER
#     一个都不设则产出未签名包；要签名则必须全部齐全。
#     申请与注入流程见 docs/deploy/apple-code-signing.md。
#
#   Sentry Source Map 上传
#     VETTA_SENTRY_AUTH_TOKEN=sntrys_xxx
#
#   Langfuse
#     LANGFUSE_SECRET_KEY="sk-lf-xx"
#
# 另注：VETTA_REQUIRE_MAC_SIGNATURE=1 仅供 macOS CI 产物校验步骤使用，
#      不是客户端配置。workflow_dispatch 只构建并保留 Actions Artifact；
#      只有匹配 package 版本的正式 tag 才会发布到 R2 / GitHub。
# ============================================================================
