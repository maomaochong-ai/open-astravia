# Vetta Desktop — environment variable index
#
# Full guide: docs/desktop/build-modes.md  ·  English: docs/desktop/build-modes.en.md
#
# Copy this file to .env.development and uncomment what you need.
# No .env.* file is tracked in git.
#
# Precedence: inline on the command line > process env > .env.<mode> > .env > code defaults.
# Packaging: VETTA_BUILD_ENV=<mode> selects which .env.<mode> to load.
#
# Every line below is commented out on purpose: a lite (serv-less) build needs
# no configuration at all. Just `bun install && bun run dev`.
#
# !! Secrets (certificates, private keys, auth tokens, cloud credentials) never
#    belong in a .env file. See the "Secrets" section of the guide.


# ─── Build mode ──────────────────────────────────────────────────────────────
# Unset (default) => lite / serv-less. Cloud code is not bundled at all.
# "true"          => full build, talks to a Vetta Serv instance.
# Build-time only: cannot be re-enabled at runtime after shipping.
# VETTA_CLOUD_ENABLED=true

# Server API endpoint. Required for full builds, unused in lite.
# VETTA_SERVER_URL=https://api.example.com/api/v1

# Site URL for the OAuth login redirect.
# Derived from VETTA_SERVER_URL when unset (drops the "api." prefix, 8080 -> 3000).
# VETTA_SITE_URL=https://www.example.com


# ─── Ability marketplace (lite only) ─────────────────────────────────────────
# Without a source repository the marketplace shows up empty in lite builds.
# Ignored in full builds: those use the official marketplace served by Vetta Serv,
# and a second built-in channel for the same ability would conflict with it.
# (Users can still add GitHub sources manually in a full build.)
# VETTA_OPEN_MARKETPLACE_REPOSITORY=https://github.com/openvetta/vetta-official-marketplace
# VETTA_OPEN_MARKETPLACE_REF=main
# VETTA_OPEN_MARKETPLACE_ARCHIVE_URL=https://github.com/owner/repo/archive/refs/heads/main.zip


# ─── Build-time trimming ─────────────────────────────────────────────────────
# Windows local speech input. Enabled unless set to "false", which drops the
# speech models, the Sherpa native runtime and the speech entry point.
# VETTA_SPEECH_INPUT_ENABLED=false

# System-plugin tenant; decides which presets get packaged.
# Values live in packages/plugins/tenants.json. Set automatically by dev/pack
# scripts, so you rarely want it here.
# VETTA_TENANT=common


# ─── Development toggles ─────────────────────────────────────────────────────
# Reveal the "UI theme" section in appearance settings (default / xianxia).
# VETTA_SHOW_UI_THEME=true


# ─── Auto-update ─────────────────────────────────────────────────────────────
# none | generic | github. Build configuration, independent of the OS.
# VETTA_UPDATE_PROVIDER=generic

# For "generic": R2, self-hosted object storage, or any static HTTP/CDN root.
# VETTA_UPDATE_URL=https://releases.example.com/desktop/stable

# For "github".
# VETTA_UPDATE_GITHUB_OWNER=owner
# VETTA_UPDATE_GITHUB_REPO=repository

# R2 upload target, used only by publish:updates:r2 (credentials are secrets).
# VETTA_R2_BUCKET=vetta-releases
# VETTA_R2_PREFIX=desktop/stable


# ─── Observability: Sentry ───────────────────────────────────────────────────
# No-op when the DSN is unset. The DSN ends up in the bundle.
# VETTA_SENTRY_DSN=https://public-key@your-sentry.example.com/project-id

# Immutable release; must match exactly between runtime and source-map upload.
# VETTA_SENTRY_RELEASE=vetta-desktop@0.0.0+local
# VETTA_TELEMETRY_ENVIRONMENT=development
# VETTA_SENTRY_TRACES_SAMPLE_RATE=0

# Source-map upload (CI only). VETTA_SENTRY_URL is for self-hosted Sentry only.
# VETTA_SENTRY_ORG=your-org-slug
# VETTA_SENTRY_PROJECT=your-project-slug
# VETTA_SENTRY_URL=https://sentry.example.com

# Emit a main-process source map locally without uploading anything.
# VETTA_MAIN_SOURCEMAP=true


# ─── Observability: PostHog ──────────────────────────────────────────────────
# Project API Key (phc_...), NOT a Personal API Key. Ends up in the renderer bundle.
# VETTA_POSTHOG_KEY=phc_xxx
# VETTA_POSTHOG_HOST=https://us.i.posthog.com
# VETTA_POSTHOG_REPLAY_ENABLED=false
# VETTA_POSTHOG_REPLAY_SAMPLE_RATE=0.05


# ─── Observability: Langfuse ─────────────────────────────────────────────────
# Opt-in end-to-end tracing of agent / LLM / tool calls.
# VETTA_TRACING=langfuse
# VETTA_TRACING_TRACE_NAME="vetta desktop"
# LANGFUSE_PUBLIC_KEY="pk-lf-xx"
# LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"
# LANGFUSE_TRACING_ENVIRONMENT=production
# LANGFUSE_RELEASE=local
# OTEL_SERVICE_NAME=vetta-agent
