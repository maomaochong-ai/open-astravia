{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"useDefineForClassFields": true,
		"forceConsistentCasingInFileNames": true,
		"jsx": "react-jsx",
		"types": [
			"vite/client"
		]
	},
	"include": [
		"src",
		"test",
		"vite.config.ts",
		"vitest.config.ts"
	]
}
